+    border-radius: var(--radius-sm);
+    border: 1px solid var(--border);
+}
+
+.msg-sources-header {
+    font-size: 12px;
+    font-weight: 600;
+    color: var(--text-secondary);
+    margin-bottom: 6px;
+}
+
+.msg-sources-item {
+    display: flex;
+    justify-content: space-between;
+    padding: 4px 0;
+    font-size: 13px;
+}
+
+.msg-sources-item-file {
+    color: var(--accent);
+}
+
+.msg-sources-item-score {
+    color: var(--text-secondary);
+    font-family: var(--font-mono);
+    font-size: 12px;
+}
+
