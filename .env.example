# 百炼平台 API 配置
BAILIAN_API_KEY=your_bailian_api_key_here
BAILIAN_MODEL=qwen-turbo

# 硅基平台 API 配置
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_MODEL=Qwen/Qwen3-Embedding-4B

# 系统配置
KNOWLEDGE_BASE_DIR=data/knowledge_base
INDEX_PATH=data/faiss_index
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
LLM_TEMPERATURE=0.7
REQUEST_TIMEOUT=30

# 认证与跨域（JWT_SECRET 必填，缺失则服务拒绝启动）
JWT_SECRET=please_change_to_a_long_random_secret
# 长期记忆持久化：会话历史自 Redis 过期后从 SQLite 按用户恢复（true 开启）
ENABLE_HISTORY_PERSISTENCE=true
# 允许访问后端的前端来源白名单（按实际部署域名收紧）
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# 面试/复习画像
# 今日一题在用户无历史数据、也无此前面试岗位时兜底使用的全局默认岗位
DEFAULT_INTERVIEW_POSITION=Java后端
# 存量旧面试数据归属账号：留空则不认领（旧数据对任何登录用户返回 403）；
# 填写后启动时会把 username='' 的旧场次归属到该账号
LEGACY_DATA_OWNER=
# 面试追问环节默认不触发真实检索（Part B §5.2）；置 true 时追问层也走检索（实验用，受成本约束）
ENABLE_INTERVIEW_FOLLOWUP_RETRIEVAL=false